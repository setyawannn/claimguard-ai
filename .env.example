# ClaimGuard AI — Environment Variables Example
# Salin menjadi .env.local (untuk tooling lokal) atau .dev.vars (untuk Wrangler Workers lokal).
# JANGAN PERNAH commit file .env, .env.local, atau .dev.vars ke GitHub.

# Cloudflare CLI / CI Deploy (Opsional jika sudah login via `bunx wrangler login`)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Keamanan & Penyamaran UU PDP No. 27/2022 (Set via `bunx wrangler secret put` di produksi)
UUPDP_HASH_SALT="ganti-dengan-random-hex-32-byte"

# On-Demand LLM Copilot (Opsional; jika kosong sistem memakai fallback deterministik)
GEMINI_API_KEY=""

# URL CDN Gateway Worker (Private R2 Proxy)
VITE_CDN_BASE_URL="https://cdn.claimguard.setyawannn.site"
